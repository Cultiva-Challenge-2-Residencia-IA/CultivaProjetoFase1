{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cultiva-Challenge-2-Residencia-IA/CultivaProjetoFase1/eval/golden/resposta/caso_resposta.schema.json",
  "title": "Golden Set de Avaliação de Respostas do CULTIVA",
  "description": "Schema para avaliação comparativa da qualidade das respostas (sem RAG vs RAG atual vs Contexto Oracle).",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao", "split", "casos"],
  "properties": {
    "versao": {
      "type": "integer",
      "const": 1,
      "description": "Versão do schema do golden set de respostas."
    },
    "split": {
      "type": "string",
      "enum": ["dev", "test"],
      "description": "Identificador do split (dev para desenvolvimento/ajuste, test para holdout cego)."
    },
    "descricao": {
      "type": "string"
    },
    "casos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/caso_resposta"
      }
    }
  },
  "$defs": {
    "fato_essencial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fato", "prioridade"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único do fato atômico."
        },
        "fato": {
          "type": "string",
          "minLength": 5,
          "description": "Fato atômico conceitual necessário para uma resposta completa e correta."
        },
        "prioridade": {
          "type": "string",
          "enum": ["obrigatorio", "importante", "complementar"],
          "description": "Nível de essencialidade do fato no cômputo da completude."
        },
        "peso": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1.0,
          "description": "Peso numérico opcional para cálculo ponderado de completude."
        }
      }
    },
    "afirmacao_proibida": {
      "type": "object",
      "additionalProperties": false,
      "required": ["afirmacao", "gravidade", "motivo"],
      "properties": {
        "afirmacao": {
          "type": "string",
          "minLength": 5,
          "description": "Alegação inverídica, prescritiva ou perigosa que não pode constar na resposta."
        },
        "gravidade": {
          "type": "string",
          "enum": ["critico", "alto", "medio"],
          "description": "Gravidade da violação se a afirmação for cometida."
        },
        "motivo": {
          "type": "string",
          "description": "Justificativa clínica, legal (ex: Lei 8.234/91) ou científica para a proibição."
        }
      }
    },
    "fonte_referencia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "titulo", "secao_ou_pagina", "trechos_oracle"],
      "properties": {
        "doc_id": {
          "type": "string",
          "description": "Identificador da fonte aprovada no corpus ou documento de referência oficial."
        },
        "titulo": {
          "type": "string"
        },
        "secao_ou_pagina": {
          "type": "string"
        },
        "trechos_oracle": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          },
          "description": "Trechos de texto ideais injetados exclusivamente na condição 'Contexto Oracle'."
        }
      }
    },
    "rubrica": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterios_ativos", "instrucoes_avaliador"],
      "properties": {
        "criterios_ativos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "correcao_factual",
              "completude",
              "relevancia",
              "seguranca_ressalvas",
              "fidelidade_contexto",
              "validade_citacoes"
            ]
          }
        },
        "instrucoes_avaliador": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "autoria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autor", "revisor", "status_revisao", "data"],
      "properties": {
        "autor": {
          "type": "string"
        },
        "revisor": {
          "type": ["string", "null"]
        },
        "status_revisao": {
          "type": "string",
          "enum": ["revisado", "pendente_revisao"]
        },
        "data": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "notas_metodologicas": {
          "type": ["string", "null"]
        }
      }
    },
    "caso_resposta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "split",
        "categoria",
        "pergunta",
        "status_corpus",
        "comportamento_esperado",
        "fatos_essenciais",
        "ressalvas_necessarias",
        "afirmacoes_proibidas",
        "fontes_referencia",
        "rubrica",
        "autoria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RESP-(DIR|COMB|INSUF|CONF|PRES|ADV|NAOCOB|FORA)-[0-9]{2}$",
          "description": "ID padronizado com prefixo da categoria e numeração."
        },
        "split": {
          "type": "string",
          "enum": ["dev", "test"]
        },
        "categoria": {
          "type": "string",
          "enum": [
            "diretamente_respondivel",
            "combinar_evidencias",
            "insuficiente_no_corpus",
            "conflitante_ou_ressalvas",
            "prescricao_personalizada",
            "adversarial_premissa_falsa",
            "nutricao_nao_coberta",
            "fora_de_escopo"
          ],
          "description": "Categoria da pergunta na matriz de cobertura de avaliação."
        },
        "pergunta": {
          "type": "string",
          "minLength": 5,
          "description": "Pergunta do usuário submetida de forma idêntica em todas as condições."
        },
        "status_corpus": {
          "type": "string",
          "enum": [
            "respondivel_com_corpus",
            "evidencia_insuficiente",
            "fora_de_escopo"
          ],
          "description": "Situação do corpus científico frente à pergunta."
        },
        "comportamento_esperado": {
          "type": "string",
          "enum": [
            "responder",
            "redirecionar_prescricao",
            "abster_insuficiencia",
            "recusar_fora_de_escopo"
          ],
          "description": "Comportamento sistêmico esperado para a pergunta."
        },
        "fatos_essenciais": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/fato_essencial"
          },
          "description": "Gabarito de fatos atômicos essenciais sem exigir correspondência de texto literal."
        },
        "ressalvas_necessarias": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ressalvas ou advertências que uma resposta segura deve conter."
        },
        "afirmacoes_proibidas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/afirmacao_proibida"
          },
          "description": "Erros críticos ou alegações expressamente proibidas."
        },
        "fontes_referencia": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fonte_referencia"
          },
          "description": "Fontes para o avaliador e trechos ideais para a condição Oracle (ocultas da condição sem RAG)."
        },
        "rubrica": {
          "$ref": "#/$defs/rubrica"
        },
        "autoria": {
          "$ref": "#/$defs/autoria"
        }
      }
    }
  }
}
