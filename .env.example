# projeto
PROJECT_NAME=CULTIVA
APP_ENV=local
LOG_LEVEL=INFO

# runtime
PYTHON_VERSION=3.11
TEMPERATURE=0
SEED=42

# modelos
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=bge-m3
LLM_PROVIDER=ollama

# banco
POSTGRES_DB=cultiva
POSTGRES_USER=cultiva
POSTGRES_PASSWORD=cultiva
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_VECTOR=pgvector/pgvector:pg17

# rastreio
TRACE_STORE_TEXT=false
TRACE_PATH=var/traces

# retrieval
RETRIEVAL_TOP_K=8
RETRIEVAL_THRESHOLD=0.2
RETRIEVAL_RERANKER=false
GROUNDING_CHECK=lite

# guardrails
VITRINE_ENABLED=false
RISK_RECALL_TARGET=0.95
RISK_TIMEOUT_SECONDS=3

# app
API_PORT=8000
CLI_MODULE=cultiva
