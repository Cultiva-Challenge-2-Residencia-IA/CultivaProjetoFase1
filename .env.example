# Provedor de LLM principal ("groq", "ollama" ou "auto")
LLM_PROVIDER=groq

# Configuração da API Gratuita Groq (obtenha gratuitamente em https://console.groq.com/keys)
GROQ_API_KEY=gsk_sua_chave_aqui
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT=30.0

# Configuração do Modelo Local (Ollama - Fallback Opcional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=45.0

# Estratégia de Vetorização Local:
# "local_lsa" usa TF-IDF + SVD denso multilíngue (zero latência de rede, 100% determinístico)
# "ollama" tenta primeiro o endpoint /api/embeddings do Ollama e faz fallback para local_lsa
VECTOR_BACKEND=local_lsa

# Parâmetros do Motor de RAG Híbrido (Fase 1 Baseline)
TOP_K_BM25=8
TOP_K_VECTOR=8
RRF_K=60
WEIGHT_BM25=0.55
WEIGHT_VECTOR=0.45
TOP_K_FINAL=4

# Observabilidade com Langfuse (opcional; desligada por padrão e no CI).
# Os traces só são enviados com CULTIVA_LANGFUSE=true e as duas chaves definidas.
# As chaves ficam no .env local, que não vai para o Git.
CULTIVA_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=pk-lf-sua_chave_aqui
LANGFUSE_SECRET_KEY=sk-lf-sua_chave_aqui
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=desenvolvimento
