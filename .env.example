# Copie para .env e preencha: cp .env.example .env
# O .env não vai para o git. Não há valores padrão no código: chat, API e avaliação
# não iniciam se o .env ou uma variável obrigatória faltar.
# Uma variável definida no terminal tem prioridade sobre o .env.

# Provedor do modelo: ollama ou falso
CULTIVA_PROVEDOR=ollama

# Obrigatórias quando CULTIVA_PROVEDOR=ollama
CULTIVA_MODELO=qwen2.5
CULTIVA_OLLAMA_URL=http://localhost:11434

# Postgres com pgvector (make db-up). Ainda não usado pela aplicação.
POSTGRES_USER=cultiva
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cultiva
POSTGRES_PORT=5432
