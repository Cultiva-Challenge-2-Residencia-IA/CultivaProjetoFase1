# Configurações do Cultiva - Template de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas configurações

# Provedor da LLM ("groq", "ollama" ou "auto")
LLM_PROVIDER=ollama
ALLOW_EXTERNAL_LLM=false

# Configurações do Modelo Local (Ollama - Padrão do Projeto)
OLLAMA_BASE_URL=http://localhost:11434
# Principal e reserva escolhidos na issue #55 (ADR 0004): ollama pull gemma4:e4b qwen2.5:7b
OLLAMA_MODEL=gemma4:e4b
OLLAMA_FALLBACK_MODEL=qwen2.5:7b
# Condições da medição do ADR 0004 (contexto, limite de saída e raciocínio desligado)
# Vale para todas as chamadas (síntese, reescrita, Sincronizador, risco e multimodal): com valores
# diferentes, o Ollama recarrega o modelo a cada troca (issue #107)
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
OLLAMA_THINK=false
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=45.0
# Agentes de área em paralelo no Chat geral com duas áreas (issue #107). O ganho exige que o servidor
# do Ollama atenda duas requisições: inicie-o com OLLAMA_NUM_PARALLEL=2 (variável do servidor, não do app)
CULTIVA_AGENTES_EM_PARALELO=true

# Configurações da API Gratuita Groq (https://console.groq.com)
GROQ_API_KEY=""
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT=30.0

# Modelo de Embeddings e Vetorização
VECTOR_COLLECTION_NAME=cultiva_nutricao_evidencias
# Modelo local do fastembed (ADR 0006). Trocar o modelo exige recalibrar ABSTENCAO_LIMIAR_COSSENO.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
EMBEDDING_NORMALIZAR_TEXTO=true
# Cache dos vetores dos Trechos (vazio desliga)
EMBEDDING_CACHE_PATH=data/vector_store/vetores_cache.sqlite3
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=200

# Parâmetros de Busca Híbrida e Reranking
TOP_K_BM25=8
TOP_K_VECTOR=8
RRF_K=60
WEIGHT_BM25=0.55
WEIGHT_VECTOR=0.45
TOP_K_FINAL=4
MAX_CHUNKS_PER_DOC=2
MODO_DENSO=chromadb_pure
RERANK_PESO_SOBREPOSICAO=0.0
RERANK_BONUS_EVIDENCIA=false

# Abstenção e Rastreabilidade
ABSTENCAO_LIMIAR_COSSENO=0.845
CULTIVA_INCLUIR_PENDENTES=false

# Autenticação dos endpoints de chat e de exclusão (issue #108; src/chat/autenticacao.py).
# Com segredo (pelo menos 32 caracteres), /chat/* e DELETE /chat/usuarios/... exigem
# "Authorization: Bearer <token>", e o Usuário vem do token. Gere um segredo e um token de teste com:
#   uv run python -m src.chat.autenticacao gerar-segredo
#   uv run python -m src.chat.autenticacao emitir --usuario usuario-teste
# Sem segredo, os endpoints recusam (503). CULTIVA_AUTH_DESLIGADA=true, só sem segredo, aceita o
# usuario_id do cliente sem autenticação: apenas uso local com dados sintéticos.
CULTIVA_AUTH_SEGREDO=
CULTIVA_AUTH_DESLIGADA=false
# Validade, em segundos, dos tokens de teste emitidos pela linha de comando.
CULTIVA_AUTH_VALIDADE_S=3600

# Observabilidade com Langfuse (opcional; desligada por padrão e no CI; ADR 0003).
# Instale o pacote com: uv sync --group observabilidade
# Os traces só são enviados com CULTIVA_LANGFUSE=true e as duas chaves definidas, e todo texto
# passa pela máscara de dados pessoais; mensagem que o portão de risco detecta não é registrada
# (o portão é por léxico e deixa passar a maioria das frases novas, #48).
# O destino padrão é um Langfuse local (auto-hospedado nesta máquina). Qualquer servidor fora de
# localhost, inclusive a nuvem do Langfuse, exige ALLOW_EXTERNAL_LANGFUSE=true e só pode receber
# perguntas sintéticas ou desidentificadas (transferência internacional, LGPD).
# As chaves ficam no .env local, que não vai para o Git.
CULTIVA_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=pk-lf-sua_chave_aqui
LANGFUSE_SECRET_KEY=sk-lf-sua_chave_aqui
LANGFUSE_BASE_URL=http://localhost:3000
ALLOW_EXTERNAL_LANGFUSE=false
LANGFUSE_TRACING_ENVIRONMENT=desenvolvimento
# Versão do código em cada trace; vazio usa o commit atual do Git.
LANGFUSE_RELEASE=

# Histórico e Fatos do Usuário (issue #112, ADR 0005). A janela é um orçamento de tokens, com no
# máximo CULTIVA_JANELA_HISTORICO mensagens. A memória de Fatos do Usuário é opt-in: o aceite vem de
# PUT /chat/usuarios/{id}/memoria; CULTIVA_MEMORIA_PADRAO (desligada, ligada, ligada_com_saude) vale
# só para testes e uso local com dados sintéticos. Fatos sem atualização expiram (proposta: 90 dias).
CULTIVA_HISTORICO_TOKENS=2500
CULTIVA_JANELA_HISTORICO=20
CULTIVA_MEMORIA_PADRAO=desligada
CULTIVA_FATOS_PRAZO_DIAS=90

# Redação final das respostas (issue #104) e camada LLM do guardrail de prescrição (issue #39).
CULTIVA_REDACAO=true
CULTIVA_PRESCRICAO_LLM=true
CULTIVA_PRESCRICAO_LLM_TIMEOUT=8

# Embeddings na GPU (opcional, uso local): exige o onnxruntime-gpu no lugar do onnxruntime.
CULTIVA_EMBEDDINGS_GPU=false
CULTIVA_EMBEDDINGS_GPU_ID=0
