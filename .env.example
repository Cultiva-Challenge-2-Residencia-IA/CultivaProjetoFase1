# Configuração do Modelo Local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=45.0

# Estratégia de Vetorização Local:
# "local_lsa" usa TF-IDF + SVD denso multilíngue (zero latência de rede, 100% determinístico)
# "ollama" tenta primeiro o endpoint /api/embeddings do Ollama e faz fallback para local_lsa
VECTOR_BACKEND=local_lsa

# Parâmetros do Motor de RAG Híbrido (Fase 1 Baseline)
TOP_K_BM25=8
TOP_K_VECTOR=8
RRF_K=60
WEIGHT_BM25=0.55
WEIGHT_VECTOR=0.45
TOP_K_FINAL=4
